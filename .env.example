# ---------------- Runtime ----------------
ENVIRONMENT=production
EXTRA_CORS_ORIGINS=

# ---------------- Storage (Cloudflare R2) ----------------
R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-access-key-id>
R2_SECRET_ACCESS_KEY=<your-secret-access-key>
R2_BUCKET_NAME=<your-bucket-name>
PUBLIC_URL_PREFIX=https://cdn.example.com

# ---------------- Application database ----------------
# SQLite file holding suggestions, pending scheduled deletions, and background-job
# state. In docker this lives on the ./data volume; override only if you need a
# different location.
# DB_PATH=data/suggestions.db

# ---------------- Image conversion ----------------
CONVERSION_SERVICE_URL=http://webp-converter:8090

# ---------------- Auth ----------------
API_KEY=<long-random-string-shared-with-authorized-users>
ALLOWED_SITES=dokimotes,dokinomicon

# ---------------- Manager UI ----------------
# Frequently visited prefixes shown in the manager's "Go to" dropdown (comma-separated).
COMMON_PREFIXES=home,example2
# Google Sheets CSV sources for the "Update from spreadsheet" button, keyed by prefix.
# Each referenced sheet tab must be link-accessible ("anyone with the link").
# gid is the tab id (from the sheet URL: .../edit#gid=<gid>). Leave empty to disable.
# CSV_SOURCES={"myprefix":[{"file":"data.csv","id":"<sheet-id>","gid":"0"}]}
CSV_SOURCES=
# Automatically re-sync every CSV_SOURCES entry every N days at 12:00 America/New_York.
# 0 (the default) keeps syncing manual-only. A scheduled run that fails any safety
# check writes nothing for that prefix and posts to DISCORD_WEBHOOK instead.
# CSV_AUTO_SYNC_DAYS=0
# A scheduled sync refuses a replacement CSV that fell below this fraction of the
# live file's rows or bytes. Default 0.5. Lower it if a sheet legitimately shrinks a lot.
# CSV_AUTO_SYNC_MIN_RATIO=0.5
# How often (seconds) the background sweep runs due "delayed delete" jobs. Default 60.
# SCHEDULED_DELETE_POLL_SECONDS=60

# ---------------- Cloudflare Turnstile ----------------
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=<from-cloudflare-dashboard>
TURNSTILE_SITE_KEY=<from-cloudflare-dashboard>

# ---------------- Discord notifications ----------------
DISCORD_WEBHOOK=https://example.com
ADMIN_URL=https://api.duck-automata.com/content-manager/
IMAGE_UPLOAD_NOTIFY_INTERVAL_SECONDS=600
